# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/logicode
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/logicode

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for contact form and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Admin Credentials (Initial Setup)
ADMIN_EMAIL=sushant@logicode.com
ADMIN_PASSWORD=admin123

# Session Secret
SESSION_SECRET=your_session_secret_key

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

