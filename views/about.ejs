<%- include('partials/header') %>

<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <h1 class="page-title">About <span class="gradient-text">Logicode</span></h1>
        <p class="page-subtitle">Empowering students through technology and innovation</p>
    </div>
</section>

<!-- Mission Section -->
<section class="mission-section">
    <div class="container">
        <div class="mission-content">
            <div class="mission-text">
                <h2>Our <span class="gradient-text">Mission</span></h2>
                <p>
                    To foster a culture of innovation and technical excellence by organizing workshops, 
                    competitions, and projects that enhance practical skills and prepare students for 
                    real-world challenges in the ever-evolving field of technology.
                </p>
                <p>
                    We believe in learning by doing, collaborating with peers, and pushing the boundaries 
                    of what's possible with code.
                </p>
            </div>
            <div class="mission-image">
                <img src="/images/mission.svg" alt="Our Mission">
            </div>
        </div>
    </div>
</section>

<!-- Vision Section -->
<section class="vision-section">
    <div class="container">
        <div class="vision-content">
            <div class="vision-image">
                <img src="/images/vision.svg" alt="Our Vision">
            </div>
            <div class="vision-text">
                <h2>Our <span class="gradient-text">Vision</span></h2>
                <p>
                    To be the leading coding club that inspires and empowers the next generation of 
                    developers, innovators, and tech leaders at TKIET Warananagar and beyond.
                </p>
                <p>
                    We envision a community where every member has the opportunity to learn, grow, 
                    and contribute to meaningful technological solutions.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="values-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Our Core <span class="gradient-text">Values</span></h2>
            <p class="section-subtitle">The principles that guide everything we do</p>
        </div>
        
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3>Innovation</h3>
                <p>We encourage creative thinking and innovative solutions to real-world problems.</p>
            </div>
            
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Collaboration</h3>
                <p>We believe in the power of teamwork and learning from each other.</p>
            </div>
            
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Growth</h3>
                <p>We are committed to continuous learning and personal development.</p>
            </div>
            
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h3>Excellence</h3>
                <p>We strive for excellence in everything we code and create.</p>
            </div>
            
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-hands-helping"></i>
                </div>
                <h3>Community</h3>
                <p>We build a supportive and inclusive community for all tech enthusiasts.</p>
            </div>
            
            <div class="value-card">
                <div class="value-icon">
                    <i class="fas fa-rocket"></i>
                </div>
                <h3>Impact</h3>
                <p>We create projects and solutions that make a positive impact.</p>
            </div>
        </div>
    </div>
</section>

<!-- President's Message -->
<section class="president-message">
    <div class="container">
        <div class="message-content">
            <div class="president-image">
                <img src="/images/president.jpg" alt="Sushant Awalekar">
                <div class="president-info">
                    <h3>Sushant Awalekar</h3>
                    <p>President, Logicode</p>
                </div>
            </div>
            <div class="message-text">
                <h2>Message from the <span class="gradient-text">President</span></h2>
                <blockquote>
                    <p>
                        "Welcome to Logicode! As the President of this amazing community, I'm thrilled 
                        to see passionate students come together to learn, build, and innovate. Our club 
                        is more than just coding – it's about creating a family of tech enthusiasts who 
                        support and inspire each other.
                    </p>
                    <p>
                        Whether you're a beginner taking your first steps in programming or an experienced 
                        developer looking to collaborate on exciting projects, Logicode is your platform 
                        to grow and excel. Together, we'll push boundaries, solve problems, and create 
                        solutions that matter.
                    </p>
                    <p>
                        Let's code the future, together!"
                    </p>
                </blockquote>
                <div class="signature">
                    <p>— Sushant Awalekar</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What We Do -->
<section class="activities-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">What We <span class="gradient-text">Do</span></h2>
            <p class="section-subtitle">Our activities and initiatives</p>
        </div>
        
        <div class="activities-grid">
            <div class="activity-card">
                <i class="fas fa-chalkboard-teacher"></i>
                <h3>Workshops & Seminars</h3>
                <p>Regular technical workshops on latest technologies and programming languages.</p>
            </div>
            
            <div class="activity-card">
                <i class="fas fa-trophy"></i>
                <h3>Coding Competitions</h3>
                <p>Organize hackathons and coding contests to challenge and showcase skills.</p>
            </div>
            
            <div class="activity-card">
                <i class="fas fa-project-diagram"></i>
                <h3>Project Development</h3>
                <p>Collaborative projects that solve real-world problems and build portfolios.</p>
            </div>
            
            <div class="activity-card">
                <i class="fas fa-user-graduate"></i>
                <h3>Mentorship Programs</h3>
                <p>Senior members mentor juniors in their coding journey and career guidance.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Join Our Community?</h2>
            <p>Become a part of Logicode and start your journey towards excellence in technology!</p>
            <a href="/register" class="btn btn-primary btn-lg">
                <i class="fas fa-user-plus"></i> Join Logicode Today
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>

