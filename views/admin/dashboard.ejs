<%- include('../partials/header') %>

<!-- Admin Header -->
<section class="admin-header">
    <div class="container">
        <div class="admin-title">
            <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
            <p>Welcome back, <%= user.name %>!</p>
        </div>
        <div class="admin-actions">
            <a href="/" class="btn btn-outline">
                <i class="fas fa-home"></i> Back to Site
            </a>
        </div>
    </div>
</section>

<!-- Stats Overview -->
<section class="admin-stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon users">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.users.total %></h3>
                    <p>Total Users</p>
                    <span class="stat-detail"><%= stats.users.active %> active</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon events">
                    <i class="fas fa-calendar"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.events.total %></h3>
                    <p>Total Events</p>
                    <span class="stat-detail"><%= stats.events.upcoming %> upcoming</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon projects">
                    <i class="fas fa-project-diagram"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.projects.total %></h3>
                    <p>Total Projects</p>
                    <span class="stat-detail"><%= stats.projects.featured %> featured</span>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon blogs">
                    <i class="fas fa-blog"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.blogs.total %></h3>
                    <p>Total Blogs</p>
                    <span class="stat-detail"><%= stats.blogs.pending %> pending</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Actions -->
<section class="quick-actions">
    <div class="container">
        <h2 class="section-title">Quick Actions</h2>
        <div class="actions-grid">
            <a href="/admin/events" class="action-card">
                <i class="fas fa-plus-circle"></i>
                <h3>Manage Events</h3>
                <p>Create and manage events</p>
            </a>

            <a href="/admin/projects" class="action-card">
                <i class="fas fa-folder-plus"></i>
                <h3>Manage Projects</h3>
                <p>Add and showcase projects</p>
            </a>

            <a href="/admin/tests" class="action-card">
                <i class="fas fa-file-alt"></i>
                <h3>Manage Tests</h3>
                <p>Create MCQ tests</p>
            </a>

            <a href="/admin/blogs" class="action-card">
                <i class="fas fa-check-circle"></i>
                <h3>Approve Blogs</h3>
                <p><%= stats.blogs.pending %> pending</p>
            </a>

            <a href="/admin/announcements" class="action-card">
                <i class="fas fa-bullhorn"></i>
                <h3>Announcements</h3>
                <p>Post to homepage</p>
            </a>

            <a href="/admin/users" class="action-card">
                <i class="fas fa-users-cog"></i>
                <h3>Manage Users</h3>
                <p>Roles and permissions</p>
            </a>
        </div>
    </div>
</section>

<!-- Recent Activity -->
<section class="recent-activity">
    <div class="container">
        <div class="activity-grid">
            <div class="activity-section">
                <h2 class="section-title">Recent Users</h2>
                <div class="activity-list">
                    <% if (activities.users && activities.users.length > 0) { %>
                        <% activities.users.forEach(user => { %>
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="activity-content">
                                    <h4><%= user.name %></h4>
                                    <p><%= user.email %></p>
                                    <span class="activity-time">
                                        <%= new Date(user.createdAt).toLocaleDateString() %>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-data">No recent users</p>
                    <% } %>
                </div>
            </div>
            
            <div class="activity-section">
                <h2 class="section-title">Recent Events</h2>
                <div class="activity-list">
                    <% if (activities.events && activities.events.length > 0) { %>
                        <% activities.events.forEach(event => { %>
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <div class="activity-content">
                                    <h4><%= event.title %></h4>
                                    <p><%= event.status %></p>
                                    <span class="activity-time">
                                        <%= new Date(event.createdAt).toLocaleDateString() %>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-data">No recent events</p>
                    <% } %>
                </div>
            </div>
            
            <div class="activity-section">
                <h2 class="section-title">Recent Blogs</h2>
                <div class="activity-list">
                    <% if (activities.blogs && activities.blogs.length > 0) { %>
                        <% activities.blogs.forEach(blog => { %>
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="fas fa-pen"></i>
                                </div>
                                <div class="activity-content">
                                    <h4><%= blog.title %></h4>
                                    <p>by <%= blog.author.name %></p>
                                    <span class="activity-time">
                                        <%= new Date(blog.createdAt).toLocaleDateString() %>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-data">No recent blogs</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Admin Navigation -->
<section class="admin-nav">
    <div class="container">
        <h2 class="section-title">Manage</h2>
        <div class="nav-grid">
            <a href="/admin/users" class="nav-card">
                <i class="fas fa-users-cog"></i>
                <h3>Users</h3>
                <p>Manage members and roles</p>
            </a>
            
            <a href="/admin/events" class="nav-card">
                <i class="fas fa-calendar-check"></i>
                <h3>Events</h3>
                <p>Manage all events</p>
            </a>
            
            <a href="/admin/projects" class="nav-card">
                <i class="fas fa-tasks"></i>
                <h3>Projects</h3>
                <p>Manage projects</p>
            </a>
            
            <a href="/admin/blogs" class="nav-card">
                <i class="fas fa-newspaper"></i>
                <h3>Blogs</h3>
                <p>Approve and manage blogs</p>
            </a>
            
            <a href="/admin/tests" class="nav-card">
                <i class="fas fa-clipboard-list"></i>
                <h3>Tests</h3>
                <p>Manage MCQ tests</p>
            </a>
            
            <a href="/admin/contacts" class="nav-card">
                <i class="fas fa-envelope"></i>
                <h3>Messages</h3>
                <p>View contact messages</p>
            </a>
        </div>
    </div>
</section>

<style>
.admin-header {
    padding: 6rem 0 2rem;
    background: var(--light-bg);
    border-bottom: 2px solid var(--border-color);
}

.admin-header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.admin-title h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.admin-title p {
    color: var(--text-muted);
}

.admin-stats {
    padding: 3rem 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--light-bg);
    border-radius: 1rem;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
}

.stat-icon {
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    font-size: 2rem;
    color: white;
}

.stat-icon.users { background: linear-gradient(135deg, #6366f1, #4f46e5); }
.stat-icon.events { background: linear-gradient(135deg, #10b981, #059669); }
.stat-icon.projects { background: linear-gradient(135deg, #f59e0b, #d97706); }
.stat-icon.blogs { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }

.stat-info h3 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
}

.stat-info p {
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
}

.stat-detail {
    color: var(--text-muted);
    font-size: 0.875rem;
}

.quick-actions,
.recent-activity,
.admin-nav {
    padding: 3rem 0;
}

.actions-grid,
.nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
}

.action-card,
.nav-card {
    padding: 2rem;
    background: var(--light-bg);
    border-radius: 1rem;
    text-align: center;
    transition: var(--transition);
    box-shadow: var(--shadow);
}

.action-card:hover,
.nav-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    background: var(--gradient-primary);
    color: white;
}

.action-card i,
.nav-card i {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--primary-color);
}

.action-card:hover i,
.nav-card:hover i {
    color: white;
}

.action-card h3,
.nav-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.action-card p,
.nav-card p {
    color: var(--text-muted);
}

.action-card:hover p,
.nav-card:hover p {
    color: rgba(255, 255, 255, 0.9);
}

.activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.activity-section {
    background: var(--light-bg);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: var(--shadow);
}

.activity-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.activity-item {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--dark-bg);
    border-radius: 0.5rem;
}

.activity-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-color);
    border-radius: 50%;
    color: white;
    flex-shrink: 0;
}

.activity-content h4 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
}

.activity-content p {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
}

.activity-time {
    color: var(--text-muted);
    font-size: 0.75rem;
}

.no-data {
    text-align: center;
    color: var(--text-muted);
    padding: 2rem;
}

@media (max-width: 768px) {
    .admin-header .container {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }
    
    .stats-grid,
    .actions-grid,
    .activity-grid,
    .nav-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<%- include('../partials/footer') %>

