<%- include('partials/header') %>

<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <h1 class="page-title">Our <span class="gradient-text">Team</span></h1>
        <p class="page-subtitle">Meet the brilliant minds behind Logicode</p>
    </div>
</section>

<!-- Leadership Section -->
<section class="leadership-section">
    <div class="container">
        <% if (president) { %>
        <div class="president-card">
            <div class="president-image-wrapper">
                <img src="<%= president.profileImage %>" alt="<%= president.name %>">
                <div class="president-badge">
                    <i class="fas fa-crown"></i>
                </div>
            </div>
            <div class="president-info">
                <h2><%= president.name %></h2>
                <p class="position">President</p>
                <% if (president.bio) { %>
                    <p class="bio"><%= president.bio %></p>
                <% } %>
                <div class="social-links">
                    <% if (president.socialLinks && president.socialLinks.github) { %>
                        <a href="<%= president.socialLinks.github %>" target="_blank"><i class="fab fa-github"></i></a>
                    <% } %>
                    <% if (president.socialLinks && president.socialLinks.linkedin) { %>
                        <a href="<%= president.socialLinks.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a>
                    <% } %>
                    <% if (president.socialLinks && president.socialLinks.twitter) { %>
                        <a href="<%= president.socialLinks.twitter %>" target="_blank"><i class="fab fa-twitter"></i></a>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>

        <% if (vicePresident) { %>
        <div class="vice-president-card">
            <div class="vp-image">
                <img src="<%= vicePresident.profileImage %>" alt="<%= vicePresident.name %>">
            </div>
            <div class="vp-info">
                <h3><%= vicePresident.name %></h3>
                <p class="position">Vice President</p>
                <% if (vicePresident.bio) { %>
                    <p class="bio"><%= vicePresident.bio %></p>
                <% } %>
                <div class="social-links">
                    <% if (vicePresident.socialLinks && vicePresident.socialLinks.github) { %>
                        <a href="<%= vicePresident.socialLinks.github %>" target="_blank"><i class="fab fa-github"></i></a>
                    <% } %>
                    <% if (vicePresident.socialLinks && vicePresident.socialLinks.linkedin) { %>
                        <a href="<%= vicePresident.socialLinks.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</section>

<!-- Core Team Section -->
<% if (coreMembers && coreMembers.length > 0) { %>
<section class="core-team-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Core <span class="gradient-text">Team</span></h2>
            <p class="section-subtitle">The backbone of our club</p>
        </div>
        
        <div class="team-grid">
            <% coreMembers.forEach(member => { %>
                <div class="team-member-card">
                    <div class="member-image">
                        <img src="<%= member.profileImage %>" alt="<%= member.name %>">
                        <div class="member-overlay">
                            <div class="member-social">
                                <% if (member.socialLinks && member.socialLinks.github) { %>
                                    <a href="<%= member.socialLinks.github %>" target="_blank"><i class="fab fa-github"></i></a>
                                <% } %>
                                <% if (member.socialLinks && member.socialLinks.linkedin) { %>
                                    <a href="<%= member.socialLinks.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="member-info">
                        <h3><%= member.name %></h3>
                        <p class="member-position"><%= member.position || 'Core Member' %></p>
                        <% if (member.department) { %>
                            <p class="member-dept"><%= member.department %></p>
                        <% } %>
                        <% if (member.skills && member.skills.length > 0) { %>
                            <div class="member-skills">
                                <% member.skills.slice(0, 3).forEach(skill => { %>
                                    <span class="skill-tag"><%= skill %></span>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- Members Section -->
<% if (members && members.length > 0) { %>
<section class="members-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Our <span class="gradient-text">Members</span></h2>
            <p class="section-subtitle">The amazing community that makes Logicode special</p>
        </div>
        
        <div class="members-grid">
            <% members.forEach(member => { %>
                <div class="member-card">
                    <img src="<%= member.profileImage %>" alt="<%= member.name %>">
                    <h4><%= member.name %></h4>
                    <% if (member.year) { %>
                        <p class="member-year"><%= member.year %></p>
                    <% } %>
                    <div class="member-links">
                        <% if (member.socialLinks && member.socialLinks.github) { %>
                            <a href="<%= member.socialLinks.github %>" target="_blank"><i class="fab fa-github"></i></a>
                        <% } %>
                        <% if (member.socialLinks && member.socialLinks.linkedin) { %>
                            <a href="<%= member.socialLinks.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- Join CTA -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Want to Join Our Team?</h2>
            <p>Become a part of Logicode and collaborate with amazing developers!</p>
            <a href="/register" class="btn btn-primary btn-lg">
                <i class="fas fa-user-plus"></i> Join Logicode
            </a>
        </div>
    </div>
</section>

<style>
.page-header {
    padding: 8rem 0 4rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
}

.leadership-section {
    padding: 4rem 0;
}

.president-card {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: center;
    background: var(--light-bg);
    border-radius: 1.5rem;
    padding: 3rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow);
}

.president-image-wrapper {
    position: relative;
}

.president-image-wrapper img {
    width: 100%;
    max-width: 300px;
    height: 300px;
    object-fit: cover;
    border-radius: 1rem;
    border: 4px solid var(--primary-color);
}

.president-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 50px;
    height: 50px;
    background: var(--gradient-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: white;
    box-shadow: var(--shadow);
}

.president-info h2 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.position {
    color: var(--primary-color);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
}

.bio {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
}

.vice-president-card {
    display: flex;
    gap: 2rem;
    background: var(--light-bg);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: var(--shadow);
}

.vp-image img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 1rem;
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
}

.team-member-card {
    background: var(--light-bg);
    border-radius: 1rem;
    overflow: hidden;
    transition: var(--transition);
    box-shadow: var(--shadow);
}

.team-member-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-lg);
}

.member-image {
    position: relative;
    overflow: hidden;
    height: 280px;
}

.member-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
}

.team-member-card:hover .member-image img {
    transform: scale(1.1);
}

.member-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(99, 102, 241, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
}

.team-member-card:hover .member-overlay {
    opacity: 1;
}

.member-social {
    display: flex;
    gap: 1rem;
}

.member-social a {
    width: 50px;
    height: 50px;
    background: white;
    color: var(--primary-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    transition: var(--transition);
}

.member-social a:hover {
    transform: scale(1.1);
    background: var(--accent-color);
    color: white;
}

.member-info {
    padding: 1.5rem;
}

.member-info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.member-position {
    color: var(--primary-color);
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.member-dept {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
}

.member-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.skill-tag {
    background: var(--dark-bg);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
}

.members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
}

.member-card {
    background: var(--light-bg);
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    transition: var(--transition);
}

.member-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.member-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 3px solid var(--primary-color);
}

.member-card h4 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
}

.member-year {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
}

.member-links {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
}

.member-links a {
    width: 35px;
    height: 35px;
    background: var(--dark-bg);
    color: var(--text-secondary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.member-links a:hover {
    background: var(--primary-color);
    color: white;
}

@media (max-width: 768px) {
    .president-card {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .president-image-wrapper img {
        margin: 0 auto;
    }
    
    .vice-president-card {
        flex-direction: column;
        text-align: center;
    }
    
    .vp-image img {
        margin: 0 auto;
    }
}
</style>

<%- include('partials/footer') %>

